{
    "name": "pivotphp/security",
    "description": "Security middlewares for PivotPHP and any PSR-15 pipeline: CORS, trusted proxies, security headers, CSRF, JWT and rate limiting",
    "type": "library",
    "keywords": [
        "php",
        "security",
        "psr-15",
        "middleware",
        "cors",
        "csrf",
        "jwt",
        "rate-limit",
        "security-headers",
        "pivotphp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Caio Alberto Fernandes"
        }
    ],
    "support": {
        "issues": "https://github.com/PivotPHP/pivotphp-security/issues",
        "source": "https://github.com/PivotPHP/pivotphp-security"
    },
    "require": {
        "php": "^8.1",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0"
    },
    "require-dev": {
        "bepsvpt/secure-headers": "^9.1",
        "firebase/php-jwt": "^7.1.1",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/rate-limiter": "^6.4|^7.0|^8.0",
        "yiisoft/csrf": "^2.2"
    },
    "suggest": {
        "bepsvpt/secure-headers": "Required by Headers\\SecurityHeadersMiddleware (^9.1)",
        "firebase/php-jwt": "Required by Jwt\\JwtAuthMiddleware (^7.1.1)",
        "symfony/rate-limiter": "Required by RateLimit\\RateLimitMiddleware (^6.4|^7.0|^8.0)",
        "yiisoft/csrf": "Required by Csrf\\CsrfMiddleware (^2.2)"
    },
    "conflict": {
        "bepsvpt/secure-headers": "<9.1",
        "firebase/php-jwt": "<7.1.1",
        "symfony/rate-limiter": "<6.4",
        "yiisoft/csrf": "<2.2"
    },
    "autoload": {
        "psr-4": {
            "PivotPHP\\Security\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PivotPHP\\Security\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "cs:check": "phpcs --standard=PSR12 src tests",
        "cs:fix": "phpcbf --standard=PSR12 src tests",
        "quality:check": [
            "@phpstan",
            "@cs:check",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
